generator client {
  provider = "prisma-client-js"
  // output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl      = env("DIRECT_URL")
}


model TestProfile {
  id String @id @default(uuid())
  name String
}
model NewTestProfile {
  id String @id @default(uuid())
  name String
}

