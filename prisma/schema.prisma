generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  company     String
  description String
  featured    Boolean
  image       String
  price       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clerkId     String   @default(uuid()) @db.Uuid
}

model PriceItem {
  id              String   @id @default(uuid()) @db.Uuid
  title           String
  price           Int?
  priceNote       String?
  design          String
  pages           String
  admin           Boolean?
  description     String
  support         Boolean
  contact         Boolean
  basicSeo        Boolean?
  advancedSeo     Boolean?
  functions       Boolean?
  // clerkId         String   @default(uuid()) @db.Uuid
}


model MediaItem {
  id                  String   @id @default(uuid()) @db.Uuid
  mediaFile           String
  title               String
  creator             String
  newsType            String
  comment             String
  commentNumber       Int
  description         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  clerkId             String   @default(uuid()) @db.Uuid
}