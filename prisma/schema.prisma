generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  company     String
  description String
  featured    Boolean
  image       String
  price       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clerkId     String   @default(uuid()) @db.Uuid
}

model PriceItem {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  price       Int?
  priceNote   String?
  design      String
  pages       String
  admin       Boolean?
  description String
  support     Boolean
  contact     Boolean
  basicSeo    Boolean?
  advancedSeo Boolean?
  functions   Boolean?
  clerkId     String?  @default(uuid()) @db.Uuid
}

model MediaItem {
  id            String   @id @default(uuid()) @db.Uuid
  mediaFile     String
  title         String
  creator       String
  newsType      String
  comment       String
  commentNumber Int
  description   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  clerkId       String   @default(uuid()) @db.Uuid
}

model OurTeam {
  id          String       @id @default(uuid()) @db.Uuid
  firstName   String
  lastName    String
  position    String
  description String
  clerkId     String
  image       String
  experiences Experience[]
  projects    Project[]
  skills      Skill[]
}

model Experience {
  id       String  @id @default(uuid()) @db.Uuid
  title    String
  company  String
  from     String
  to       String?
  personId String  @db.Uuid
  person   OurTeam @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model Project {
  id          String  @id @default(uuid()) @db.Uuid
  title       String
  projectInfo String
  projectLink String?
  personId    String  @db.Uuid
  person      OurTeam @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

model Skill {
  id       String  @id @default(uuid()) @db.Uuid
  title    String?
  personId String  @db.Uuid
  person   OurTeam @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

model ServiceBlogItem {
  id          String @id @default(uuid()) @db.Uuid
  title       String @unique
  image       String
  description String
}

model ServiceInfo {
  id    String @id @default(uuid()) @db.Uuid
  title String @unique
  info  String
}

model NewsPost {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String
  image       String
  category    String
  avgRating   Float?
  ratingCount Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  reviews     Review[]
}

model Review {
  id          String   @id @default(uuid()) @db.Uuid
  rating      Int?
  comment     String
  userId      String?
  platform    String?
  externalId  String?
  authorName  String?
  authorImage String?
  sourceUrl   String?
  newsPostId  String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  newsPost    NewsPost @relation(fields: [newsPostId], references: [id])
}
